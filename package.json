{
  "name": "capri-desktop",
  "version": "0.3.1",
  "description": "Capri, the Project Capricorn construct, living on your desktop and narrating what Claude Code is doing.",
  "author": "mochiiwuff",
  "repository": "github:mochiiwuff/capri-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "build:helper": "node scripts/build-mac-helper.js",
    "postinstall": "node scripts/build-mac-helper.js --optional",
    "dist": "electron-builder --win",
    "dist:mac": "npm run build:helper && electron-builder --mac"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners",
    "macos"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "build": {
    "appId": "capri.desktop",
    "productName": "Capri",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/windows.ps1"
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capri.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icons/capri-mac.png",
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Capri plays, pauses and skips your music in Music or Spotify when you ask her to."
      },
      "extraResources": [
        {
          "from": "native/mac-helper/bin",
          "to": "bin"
        }
      ],
      "x64ArchFiles": "Contents/Resources/bin/*",
      "artifactName": "Capri-${version}-mac.${ext}",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Capri",
      "artifactName": "Capri-Setup-${version}.${ext}"
    },
    "dmg": {
      "title": "Capri ${version}"
    }
  }
}
